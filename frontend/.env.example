# json：浏览器/Tauri 本地数据模式；api：调用 Wedding Coordinator 后端。
VITE_DATA_MODE=json
VITE_API_BASE_URL=http://localhost:9988/wedding-coordinator/api
VITE_API_TIMEOUT_MS=12000
VITE_PROJECT_ID=wedding-2026-demo

# disabled：本地单机模式；adabas：通过 Wedding Coordinator 后端代理统一登录。
VITE_AUTH_MODE=disabled

# 公开电子请帖 H5 部署地址。
VITE_PUBLIC_INVITATION_BASE_URL=http://localhost:18766/invite.html

# 前端禁止配置 ADABAS ApiToken，也禁止直接访问 ADABAS_BASE_URL。
# 登录地址必须由后端 POST /api/auth/login-url 动态返回。
